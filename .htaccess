Options +SymLinksIfOwnerMatch
RewriteEngine On

# Allow Installatron requests
RewriteCond %{REQUEST_FILENAME} deleteme\.\w+\.php
RewriteRule (.*) - [L]

# Block private Laravel storage folders
RewriteRule ^storage/app/(?!public/) - [F]
RewriteRule ^storage/framework/ - [F]
RewriteRule ^storage/logs/ - [F]

# Product / upload images: /storage/products/xxx.jpg -> storage/app/public/products/xxx.jpg
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/storage/app/public/$1 -f
RewriteRule ^storage/(.*)$ storage/app/public/$1 [L]

# Files inside /public when the site root is the project folder
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(.*)$ public/$1 [L]

# Real files and folders (css, js, existing images)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else to Laravel
RewriteRule ^ index.php [L]
